{
  "name": "paperchaser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:update": "UPDATE_BASELINES=1 playwright test tests/parity.spec.ts -g golden",
    "check:comments": "node scripts/findCommentViolations.ts",
    "check:naming": "ls-lint",
    "check:no-use-effect": "! grep -rnE '\\buse(Layout)?Effect\\s*\\(' src --include='*.tsx'",
    "check:conventions": "pnpm lint && pnpm check:comments && pnpm check:naming && pnpm check:no-use-effect",
    "schema:update": "UPDATE_SCHEMA=1 vitest run src/project/__tests__/workspaceSchema.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.63",
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@tanstack/react-router": "1.170.31",
    "ai": "^7.0.128",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "4.4.5",
    "dockview-react": "^8.4.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@ls-lint/ls-lint": "^2.3.1",
    "@napi-rs/canvas": "^1.0.7",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "6.2.5",
    "oxc-parser": "^0.153.0",
    "oxlint": "^1.79.0",
    "pdfjs-dist": "6.2.108",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-window": "^7.4.1"
  }
}
