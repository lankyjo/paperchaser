{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/document/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "dexie",
                  "**/components/**",
                  "**/db/**",
                  "**/routes/**"
                ],
                "message": "src/document is pure domain code: no React, Dexie or UI imports."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "localStorage",
          "sessionStorage",
          "navigator",
          "indexedDB"
        ]
      }
    },
    {
      "files": [
        "src/db/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "**/components/**",
                  "**/routes/**"
                ],
                "message": "src/db is persistence only: no React or UI imports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/__tests__/**",
        "tests/**"
      ],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off"
      }
    }
  ]
}
